{
  "name": "promptfuzz",
  "version": "0.1.0",
  "description": "토큰을 수염으로, 휴식을 면도로 — Claude Code 사용 시간 관리 CLI 토이",
  "type": "module",
  "bin": {
    "promptfuzz": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "perf": "node scripts/perf-check.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "productivity",
    "wellness",
    "stretching",
    "tokens",
    "developer-tools",
    "korean"
  ],
  "author": "khv9786 <hyunvin02@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/khv9786/promptFuzz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khv9786/promptFuzz.git"
  },
  "bugs": {
    "url": "https://github.com/khv9786/promptFuzz/issues"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.3",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
