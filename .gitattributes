# Default to LF for text files
* text=auto eol=lf

# Shell scripts must be LF (Linux CI에서 실행)
*.sh text eol=lf

# Windows batch files must be CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.docx binary
*.pdf binary
